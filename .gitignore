# Ignore everything
*

# Track specific files
!.gitignore
!.gitconfig
!.cargo/
!.cargo/config.toml
!.config/
!.config/fish/
!.config/fish/config.fish
!.config/gitui/
!.config/gitui/key_bindings.ron
!.config/helix/
!.config/helix/config.toml
!.config/helix/languages.toml
!.config/jj/
!.config/jj/config.toml
!.config/opencode/
!.config/opencode/opencode.json
!.config/starship.toml
!.config/wezterm/
!.config/wezterm/wezterm.lua
!.config/zed/
!.config/zed/settings.json
!README.md

# pi agent config (auth.json, sessions/, npm/, logs stay ignored)
!.pi/
!.pi/agent/
!.pi/agent/AGENTS.md
!.pi/agent/agents/
!.pi/agent/agents/**
!.pi/agent/extensions/
!.pi/agent/extensions/ai-init.ts
!.pi/agent/extensions/pi-permission-system/
!.pi/agent/extensions/pi-permission-system/config.json
!.pi/agent/settings.json
!.pi/agent/skills/
!.pi/agent/skills/**
!.pi/agent/prompts/
!.pi/agent/prompts/**
