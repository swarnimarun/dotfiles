# Ghostty profile aligned with ~/.config/wezterm/wezterm.lua.
#
# Only settings that map cleanly to Ghostty are mirrored here:
# - theme and font
# - basic shell startup
# - spacing and cursor behavior
# - portable keybinds for tabs, splits, search, and window control
#
# Plugin-driven WezTerm features such as tabline, sessionizer, and launcher
# workflows are intentionally not ported.

font-family = JetBrains Mono
font-size = 12
theme = Dark+

# Match the WezTerm default shell.
command = fish
shell-integration = fish
shell-integration-features = cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path

# Keep the terminal visually close to the WezTerm padding and interaction
# choices.
window-padding-x = 6
window-padding-y = 5
background-opacity = 1
mouse-hide-while-typing = false
cursor-style = block

# Cleanly portable keybinds.
keybind = ctrl+shift+,=unbind
keybind = ctrl+shift+r=reload_config
keybind = ctrl+,=open_config
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+f=start_search
keybind = escape=end_search
keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+shift+comma=new_split:right
keybind = ctrl+shift+period=new_split:down
keybind = ctrl+shift+o=toggle_tab_overview
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+enter=toggle_fullscreen
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+l=resize_split:right,10
keybind = super+ctrl+shift+arrow_up=resize_split:up,10
keybind = super+ctrl+shift+arrow_down=resize_split:down,10
keybind = super+ctrl+shift+arrow_left=resize_split:left,10
keybind = super+ctrl+shift+arrow_right=resize_split:right,10
keybind = alt+h=text:\x1b[D
keybind = alt+j=text:\x1b[B
keybind = alt+k=text:\x1b[A
keybind = alt+l=text:\x1b[C
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab
