// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "rill-lsp": {
      "binary": {
        "path": "/Users/swarnim/.cargo/bin/rill-lsp",
        "arguments": []
      },
      "languages": ["Rill"]
    }
  },
  "terminal": {
    "shell": {
      "program": "fish"
    }
  },
  "active_pane_modifiers": {
    "inactive_opacity": 0.6
  },
  "git": {
    "disable_git": false
  },
  "disable_ai": false,
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "pi-acp": {
      "favorite_config_option_values": {
        "thought_level": [
          "xhigh",
          "off"
        ]
      },
      "default_config_options": {
        "thought_level": "high"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "helix_mode": true,
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Retrofit Dark",
  // comx (see extensions/comx-zed): render purely from comx-lsp semantic tokens
  // (no tree-sitter grammar exists yet).
  "languages": {
    "comx": {
      "semantic_tokens": "full"
    },
    // Rill (see extensions/rill-zed in the rill repo): highlighting comes
    // from `rill lsp` semantic tokens; there is no tree-sitter grammar.
    "Rill": {
      "semantic_tokens": "full",
      "inlay_hints": {
        "enabled": true,
        "show_type_hints": true
      }
    }
  },
}
