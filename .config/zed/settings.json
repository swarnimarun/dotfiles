// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "openai_compatible": {
      "ZenMux KatCoder": {
        "api_url": "https://zenmux.ai/api/v1",
        "available_models": [
          {
            "name": "kuaishou/kat-coder-pro-v1",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      },
      "ZenMux AI": {
        "api_url": "https://zenmux.ai/api/v1",
        "available_models": [
          {
            "name": "z-ai/glm-4.6v-flash",
            "max_tokens": 200000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"],
      "env": {}
    }
  },
  "agent": {
    "default_model": {
      "provider": "ZenMux KatCoder",
      "model": "kuaishou/kat-coder-pro-v1"
    },
    "model_parameters": []
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark"
  }
}
